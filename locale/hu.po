msgid "The linked file is larger than 100 MB."
msgstr "A hivatkozott fájl mérete meghaladja a 100 MB-ot."

msgctxt "model:ir.message,text:msg_attachment_reader_group_uniq"
msgid "Attachment can only have the same Reader Group once."
msgstr "Ugyanaz az olvasói csoport csak egyszer rendelhető egy melléklethez."

#, python-format
msgctxt "model:ir.message,text:msg_attachment_without_data"
msgid "Attachment \"%(attachment)s\" has no file to download."
msgstr "A(z) „%(attachment)s” mellékletnek nincs letölthető fájlja."

msgctxt "model:ir.message,text:msg_attachment_writer_group_uniq"
msgid "Attachment can only have the same Writer Group once."
msgstr "Ugyanaz az írói csoport csak egyszer rendelhető egy melléklethez."

msgctxt "model:ir.message,text:msg_category_group_unique"
msgid "A group can be linked to a category only once for this access level."
msgstr ""
"Egy csoport ezen a hozzáférési szinten csak egyszer kapcsolható egy "
"kategóriához."

msgctxt "model:ir.message,text:msg_category_name_unique"
msgid "Category name must be unique per parent."
msgstr ""
"A kategórianévnek egyedinek kell lennie az adott szülőkategórián belül."

msgctxt "model:ir.message,text:msg_category_user_unique"
msgid "A user can be linked to a category only once for this access level."
msgstr ""
"Egy felhasználó ezen a hozzáférési szinten csak egyszer kapcsolható egy "
"kategóriához."

msgctxt "model:ir.message,text:msg_invalid_attachment_link"
msgid "The attachment link must use HTTP or HTTPS."
msgstr "A melléklet hivatkozásának HTTP-t vagy HTTPS-t kell használnia."

msgctxt "model:ir.message,text:msg_invalid_output_format"
msgid "The selected output format is not valid."
msgstr "A kiválasztott kimeneti formátum érvénytelen."

#, python-format
msgctxt "model:ir.message,text:msg_missing_categories"
msgid ""
"Attachment \"%(document)s\" must have one of the categories inside "
"\"%(categories)s\"."
msgstr ""
"A(z) „%(document)s” mellékletnek a(z) „%(categories)s” valamely "
"kategóriájába kell tartoznia."

msgctxt "model:ir.message,text:msg_no_attachments_selected"
msgid "Select at least one attachment."
msgstr "Válasszon ki legalább egy mellékletet."

#, python-format
msgctxt "model:ir.message,text:msg_repeated_unique"
msgid ""
"Attachment \"%(document)s\" has more than one child category of "
"\"%(category)s\"."
msgstr ""
"A(z) „%(document)s” melléklet a(z) „%(category)s” több alkategóriájába "
"tartozik."

