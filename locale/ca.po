msgctxt "model:ir.message,text:msg_attachment_category_uniq"
msgid "Attachment can only have the same Category once."
msgstr "Un adjunt no pot tenir dues vegades la mateixa categoria."

msgctxt "model:ir.message,text:msg_attachment_conversion_failed"
msgid "LibreOffice could not convert the attachment: %(error)s"
msgstr "LibreOffice no ha pogut convertir l'adjunt: %(error)s"

msgctxt "model:ir.message,text:msg_attachment_link_download_failed"
msgid "The linked file could not be downloaded: %(error)s"
msgstr "No s'ha pogut descarregar el fitxer enllaçat: %(error)s"

msgctxt "model:ir.message,text:msg_attachment_link_too_large"
msgid "The linked file is larger than 100 MB."
msgstr "El fitxer enllaçat és més gran de 100 MB."

msgctxt "model:ir.message,text:msg_attachment_reader_group_uniq"
msgid "Attachment can only have the same Reader Group once."
msgstr "Un adjunt no pot tenir dues vegades el mateix grup de lectors."

msgctxt "model:ir.message,text:msg_attachment_without_data"
msgid "Attachment \"%(attachment)s\" has no file to download."
msgstr "L'adjunt \"%(attachment)s\" no té cap fitxer per descarregar."

msgctxt "model:ir.message,text:msg_attachment_writer_group_uniq"
msgid "Attachment can only have the same Writer Group once."
msgstr "Un adjunt no pot tenir dues vegades el mateix grup d'escriptors."

msgctxt "model:ir.message,text:msg_category_group_unique"
msgid "A group can be linked to a category only once for this access level."
msgstr ""
"Un grup només es pot vincular una vegada a una categoria per a aquest nivell "
"d'accés."

msgctxt "model:ir.message,text:msg_category_name_unique"
msgid "Category name must be unique per parent."
msgstr "El nom de la categoria ha de ser únic per pare."

msgctxt "model:ir.message,text:msg_category_user_unique"
msgid "A user can be linked to a category only once for this access level."
msgstr ""
"Un usuari només es pot vincular una vegada a una categoria per a aquest "
"nivell d'accés."

msgctxt "model:ir.message,text:msg_invalid_attachment_link"
msgid "The attachment link must use HTTP or HTTPS."
msgstr "L'enllaç de l'adjunt ha d'utilitzar HTTP o HTTPS."

msgctxt "model:ir.message,text:msg_invalid_output_format"
msgid "The selected output format is not valid."
msgstr "El format de sortida seleccionat no és vàlid."

msgctxt "model:ir.message,text:msg_missing_categories"
msgid ""
"Attachment \"%(document)s\" must have one of the categories inside "
"\"%(categories)s\"."
msgstr ""
"L'adjunt \"%(document)s\" ha de tenir una de les categories de "
"\"%(categories)s\"."

msgctxt "model:ir.message,text:msg_no_attachments_selected"
msgid "Select at least one attachment."
msgstr "Seleccioneu com a mínim un adjunt."

msgctxt "model:ir.message,text:msg_repeated_unique"
msgid ""
"Attachment \"%(document)s\" has more than one child category of "
"\"%(category)s\"."
msgstr "L'adjunt \"%(document)s\" té més d'una categoria filla de \"%(category)s\"."

msgctxt "model:ir.message,text:msg_soffice_not_found"
